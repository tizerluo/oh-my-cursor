{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 {{REVIEW_GATE_QUOTED_PATH}} check-merge",
        "matcher": "gh\\s+pr\\s+merge|gh\\s+api[^\\n]*\\/merge|(?:curl|wget|http)[^\\n]*api\\.github\\.com[^\\n]*\\/merge|git\\s+push\\b",
        "failClosed": true,
        "omc": true
      }
    ],
    "preToolUse": [
      {
        "command": "python3 {{REVIEW_GATE_QUOTED_PATH}} check-tool-permission",
        "matcher": "Shell",
        "failClosed": true,
        "omc": true
      },
      {
        "command": "python3 {{REVIEW_GATE_QUOTED_PATH}} check-merge",
        "matcher": "Shell",
        "failClosed": true,
        "omc": true
      },
      {
        "command": "python3 {{REVIEW_GATE_QUOTED_PATH}} check-task-alignment",
        "matcher": "Task",
        "failClosed": true,
        "omc": true
      },
      {
        "command": "python3 {{REVIEW_GATE_QUOTED_PATH}} check-tool-permission",
        "matcher": "Write|Delete",
        "failClosed": true,
        "omc": true
      }
    ],
    "subagentStart": [
      {
        "command": "python3 {{REVIEW_GATE_QUOTED_PATH}} set-role",
        "matcher": "[Cc]oder|[Aa]rchitect|[Tt]ester[-_]?[Ww]riter|[Rr]eviewer[-_]?[Gg]rok|[Rr]eviewer[-_]?[Cc]odex|[Rr]eviewer[-_]?[Gg]emini|[Ee]xplore|[Gg]eneral[-_]?[Pp]urpose|[Pp]lanner",
        "failClosed": true,
        "omc": true
      }
    ],
    "subagentStop": [
      {
        "command": "REVIEW_GATE_HOOK_MODE=subagentStop python3 {{REVIEW_GATE_QUOTED_PATH}} record-subagent",
        "matcher": "[Cc]oder|[Aa]rchitect|[Tt]ester[-_]?[Ww]riter|[Rr]eviewer[-_]?[Gg]rok|[Rr]eviewer[-_]?[Cc]odex|[Rr]eviewer[-_]?[Gg]emini|[Ee]xplore|[Gg]eneral[-_]?[Pp]urpose|[Pp]lanner",
        "omc": true
      },
      {
        "command": "REVIEW_GATE_HOOK_MODE=subagentStop python3 {{REVIEW_GATE_QUOTED_PATH}} record-subagent",
        "matcher": "[Cc]oder|[Aa]rchitect|[Tt]ester[-_]?[Ww]riter|[Rr]eviewer[-_]?[Gg]rok|[Rr]eviewer[-_]?[Cc]odex|[Rr]eviewer[-_]?[Gg]emini|[Ee]xplore|[Gg]eneral[-_]?[Pp]urpose|[Pp]lanner",
        "omc": true
      },
      {
        "command": "REVIEW_GATE_HOOK_MODE=subagentStop python3 {{REVIEW_GATE_QUOTED_PATH}} record-subagent",
        "matcher": "[Cc]oder|[Aa]rchitect|[Tt]ester[-_]?[Ww]riter|[Rr]eviewer[-_]?[Gg]rok|[Rr]eviewer[-_]?[Cc]odex|[Rr]eviewer[-_]?[Gg]emini|[Ee]xplore|[Gg]eneral[-_]?[Pp]urpose|[Pp]lanner",
        "omc": true
      }
    ],
    "stop": [
      {
        "command": "python3 {{REVIEW_GATE_QUOTED_PATH}} stop-check",
        "loop_limit": 5,
        "omc": true
      }
    ],
    "sessionStart": [
      {
        "command": "python3 {{REVIEW_GATE_QUOTED_PATH}} session-resume",
        "omc": true
      }
    ],
    "preCompact": [
      {
        "command": "python3 {{REVIEW_GATE_QUOTED_PATH}} compact-inject",
        "failClosed": false,
        "omc": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 {{REVIEW_GATE_QUOTED_PATH}} check-mcp-permission",
        "failClosed": false,
        "omc": true
      }
    ]
  }
}
