{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 {{REVIEW_GATE_PATH}} check-merge",
        "matcher": "gh\\s+pr\\s+merge|gh\\s+api[^\\n]*\\/merge|(?:curl|wget|http)[^\\n]*api\\.github\\.com[^\\n]*\\/merge|git\\s+push\\b",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "python3 {{REVIEW_GATE_PATH}} check-merge",
        "matcher": "Shell"
      },
      {
        "command": "python3 {{REVIEW_GATE_PATH}} check-task-alignment",
        "matcher": "Task"
      },
      {
        "command": "python3 {{REVIEW_GATE_PATH}} check-tool-permission",
        "matcher": "Write|Delete",
        "failClosed": true
      }
    ],
    "subagentStart": [
      {
        "command": "python3 {{REVIEW_GATE_PATH}} set-role",
        "matcher": "coder|architect|tester-writer|reviewer-grok|reviewer-codex|reviewer-gemini|explore|generalPurpose"
      }
    ],
    "subagentStop": [
      {
        "command": "REVIEW_GATE_HOOK_MODE=subagentStop python3 {{REVIEW_GATE_PATH}} record-subagent",
        "matcher": "coder"
      },
      {
        "command": "REVIEW_GATE_HOOK_MODE=subagentStop python3 {{REVIEW_GATE_PATH}} record-subagent",
        "matcher": "reviewer-grok|reviewer-codex|reviewer-gemini"
      },
      {
        "command": "REVIEW_GATE_HOOK_MODE=subagentStop python3 {{REVIEW_GATE_PATH}} record-subagent",
        "matcher": "architect|explore|generalPurpose"
      }
    ],
    "stop": [
      {
        "command": "python3 {{REVIEW_GATE_PATH}} stop-check",
        "loop_limit": 5
      }
    ],
    "sessionStart": [
      {
        "command": "python3 {{REVIEW_GATE_PATH}} session-resume"
      }
    ]
  }
}
