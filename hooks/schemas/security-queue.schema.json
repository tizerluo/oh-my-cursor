{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecurityQueue",
  "type": "object",
  "required": ["schema_version", "session_id", "pending_findings"],
  "properties": {
    "schema_version": { "type": "integer" },
    "session_id": { "type": "string" },
    "pending_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fingerprint", "severity", "asset", "vuln_class"],
        "properties": {
          "fingerprint": { "type": "string" },
          "severity": { "type": "string" },
          "asset": { "type": "string" },
          "vuln_class": { "type": "string" },
          "sink": { "type": "string" },
          "exploitability": { "type": "string" },
          "verified": { "type": "boolean" }
        }
      }
    }
  }
}
